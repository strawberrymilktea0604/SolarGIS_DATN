# =============================================================================
# SolarGIS Digital Twin - Dockerfile.backend
# Build Rust Axum REST API + SQLx PostGIS + Typst CLI/Library
# =============================================================================

FROM rust:1.82-bookworm AS builder

WORKDIR /usr/src/app
COPY modules/module3_digital_twin_app/Cargo.toml ./Cargo.toml
COPY modules/module3_digital_twin_app/crates ./crates

RUN cargo build --release --bin solar_backend

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    curl \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Typst binary for fast PDF compilation inside tokio::task::spawn_blocking
RUN curl -fsSL https://github.com/typst/typst/releases/download/v0.12.0/typst-x86_64-unknown-linux-musl.tar.xz \
    | tar -xJ --strip-components=1 -C /usr/local/bin typst-x86_64-unknown-linux-musl/typst

WORKDIR /app
COPY --from=builder /usr/src/app/target/release/solar_backend /app/solar_backend
COPY modules/module3_digital_twin_app/templates /app/templates

EXPOSE 8080
CMD ["/app/solar_backend"]
