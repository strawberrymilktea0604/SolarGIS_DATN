# =============================================================================
# SolarGIS Digital Twin - Environment Template (.env.example)
# Cách dùng: Sao chép file này thành .env (cp .env.example .env) và điền mật khẩu
# =============================================================================

POSTGRES_USER=solargis
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=solargis_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Chuỗi kết nối cho Rust Axum Backend & Python Scripts khi chạy trên máy host
DATABASE_URL=postgres://solargis:CHANGE_ME_STRONG_PASSWORD@localhost:5432/solargis_db
REDIS_URL=redis://localhost:6379

# URL Backend cho Next.js Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
